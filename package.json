{
  "name": "vita",
  "version": "0.1.1",
  "private": true,
  "description": "Local-first, bring-your-own-model nutrition assistant for Android",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lztpho/Vita.git"
  },
  "bugs": {
    "url": "https://github.com/lztpho/Vita/issues"
  },
  "homepage": "https://github.com/lztpho/Vita#readme",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --pretty false",
    "android:sync": "npm run build && cap sync android",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "licenses:npm": "node scripts/generate-third-party-notices.mjs",
    "licenses": "node scripts/generate-third-party-notices.mjs --require-android",
    "audit:osv": "node scripts/osv-audit.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx > build/npm-sbom.cdx.json"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/camera": "8.2.2",
    "@capacitor/core": "8.5.0",
    "@capacitor/splash-screen": "8.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
